---
import type { RecognitionPageContent } from '../lib/content/types';
import ButtonLink from './ButtonLink.astro';
import ManagedPicture from './ManagedPicture.astro';

interface Props {
  content: RecognitionPageContent['hero'];
}

const { content } = Astro.props;
---

<section
  class="tw:relative tw:min-h-[calc(100svh-var(--header-height))] tw:overflow-hidden tw:bg-white tw:py-[clamp(2.5rem,4vw,4rem)]"
  aria-labelledby="page-title"
>
  <div
    class="container tw:grid tw:items-center tw:gap-[clamp(4rem,8vw,9rem)] tw:xl:grid-cols-[minmax(28rem,1.12fr)_minmax(22rem,.88fr)]"
  >
    <div class="tw:relative tw:z-10">
      <p
        class="tw:mb-6 tw:text-[.68rem] tw:font-bold tw:tracking-[.16em] tw:text-lapis tw:uppercase"
        data-hero-reveal
      >
        {content.frameLabel}
      </p>
      <h1
        id="page-title"
        class="tw:max-w-[12ch] tw:text-[clamp(3.15rem,7vw,7rem)] tw:leading-[1.02] tw:tracking-[-.048em]"
        data-hero-reveal
      >
        {content.title}
      </h1>
      <div class="tw:mt-10 tw:flex tw:flex-wrap tw:gap-3" data-hero-reveal>
        <ButtonLink {...content.primaryAction} variant="primary" />
        {content.secondaryAction && <ButtonLink {...content.secondaryAction} variant="secondary" />}
      </div>
    </div>

    <figure
      class="tw:relative tw:m-0 tw:mx-auto tw:grid tw:w-full tw:max-w-[37rem] tw:place-items-center"
      data-hero-visual
    >
      <div class="tw:relative tw:grid tw:min-h-[27rem] tw:place-items-center tw:overflow-hidden">
        <ManagedPicture
          image={content.image}
          class="tw:relative tw:z-10 tw:h-[clamp(27rem,36vw,35rem)] tw:w-full tw:object-contain tw:mix-blend-multiply"
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 1280px) 38vw, (min-width: 768px) 52vw, 92vw"
          widths={[420, 560, 720, 900, 1024]}
          quality={90}
        />
      </div>
    </figure>
  </div>
</section>
